# Downstream .NET API credentials (when required)
# MCP_DOTNET_API_KEY=
# MCP_DOTNET_API_TOKEN=

# Local Ollama service configuration (defaults to http://localhost:11434, no credentials required)
# MCP_OLLAMA_BASE_URL=http://localhost:11434
# MCP_OLLAMA_TIMEOUT=60

# Model overrides (defaults to bge-m3:latest for embedding, qwen:1.8b for reranking)
# MCP_EMBEDDING_MODEL=bge-m3:latest
# MCP_RERANKER_MODEL=qwen:1.8b

# Remote provider mode credentials (only needed if provider is switched from 'ollama' to 'remote')
# EMBEDDING_API_KEY=
# RERANKER_API_KEY=
