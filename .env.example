# Remote Embedding Service Token (Production)
# Used when search.embedding.provider is set to 'remote'
EMBEDDING_API_KEY=

# Remote Reranking Service Token (Production)
# Used when search.reranking.provider is set to 'remote'
RERANKER_API_KEY=

# Downstream Target API Bearer Token (if required by the target API)
API_BEARER_TOKEN=
